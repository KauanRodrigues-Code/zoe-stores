# Endereço público final do site (sem barra no fim). Usado em sitemap, robots e Open Graph.
# Não é segredo. Defina na hospedagem quando o domínio estiver definido.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Opcional) Corrige a localização do mapa e dos links "Como chegar".
# Aceita endereço, nome do estabelecimento ou "lat,lng". Vazio = usa o endereço de lib/site.ts.
# Não é segredo e não usa chave de API.
# NEXT_PUBLIC_MAP_QUERY=
